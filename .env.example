# Copie para .env.local no desenvolvimento, ou cadastre no console do Amplify em
# App settings → Environment variables. Só variáveis com o prefixo VITE_ chegam
# ao navegador — nunca coloque segredo aqui, o bundle é público.

# mock  → dados de demonstração locais (padrão, é o que roda hoje)
# aws   → consome a API real definida em VITE_API_URL e autentica pelo Cognito
VITE_DATA_SOURCE=mock

# URL base da API (API Gateway, App Runner, ALB…), sem barra no final.
VITE_API_URL=

VITE_AWS_REGION=us-east-1

# Amazon Cognito — preencher quando o User Pool existir.
VITE_COGNITO_USER_POOL_ID=
VITE_COGNITO_CLIENT_ID=
VITE_COGNITO_DOMAIN=

# Endereço público do site, usado em links canônicos.
VITE_SITE_URL=https://tobias.feliz.web.ufersa.dev.br
