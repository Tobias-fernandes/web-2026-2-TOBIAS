# Copy to .env.local for development, or register them in the Amplify console
# under App settings → Environment variables. Only variables prefixed with VITE_
# reach the browser — never put a secret here, the bundle is public.

# mock  → local demo data (default, what runs today)
# aws   → uses the real API set in VITE_API_URL
VITE_DATA_SOURCE=mock

# mock     → sign-in against the fixed demo users (default)
# cognito  → real SRP against the User Pool below
# Independent of VITE_DATA_SOURCE: you can sign in to the real Cognito while
# member/project data still comes from the mock, because sign-in does not need
# the API to exist — it only talks to Cognito.
VITE_AUTH_SOURCE=mock

# Base URL of the API (API Gateway, App Runner, ALB…), without a trailing slash.
VITE_API_URL=

VITE_AWS_REGION=us-east-1

# Amazon Cognito — fill in once the User Pool exists.
VITE_COGNITO_USER_POOL_ID=
VITE_COGNITO_CLIENT_ID=
VITE_COGNITO_DOMAIN=
