# Copie para .env.local no desenvolvimento, ou cadastre no console do Amplify em
# App settings → Environment variables. Só variáveis com o prefixo VITE_ chegam
# ao navegador — nunca coloque segredo aqui, o bundle é público.

# mock  → dados de demonstração locais (padrão, é o que roda hoje)
# aws   → consome a API real definida em VITE_API_URL
VITE_DATA_SOURCE=mock

# mock     → login contra os usuários fixos da demonstração (padrão)
# cognito  → SRP de verdade contra o User Pool abaixo
# Independente de VITE_DATA_SOURCE: dá para logar no Cognito de verdade com os
# dados de membros/projetos ainda vindo do mock, porque o login não depende da
# API existir — só fala com o Cognito.
VITE_AUTH_SOURCE=mock

# URL base da API (API Gateway, App Runner, ALB…), sem barra no final.
VITE_API_URL=

VITE_AWS_REGION=us-east-1

# Amazon Cognito — preencher quando o User Pool existir.
VITE_COGNITO_USER_POOL_ID=
VITE_COGNITO_CLIENT_ID=
VITE_COGNITO_DOMAIN=
